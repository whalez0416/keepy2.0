# App Settings
APP_NAME=Keepy MVP
DEBUG=True

# Database
# 로컬은 SQLite, 운영은 PostgreSQL(postgresql://user:pw@host:5432/db) 권장
DATABASE_URL=sqlite:///./keepy.db

# === 보안 (운영 필수) ===
# JWT 서명 키: 길고 랜덤한 문자열. 운영(DEBUG=False)에서 미설정 시 서버가 켜지지 않음.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# 로그인 토큰 유효시간(분). 기본 1440분(24시간).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === 마스터(운영자) 계정 — B2B 수동 발급용 ===
# 이 계정으로 로그인 후, 고객별 관리자 계정을 발급합니다.
MASTER_EMAIL=master@keepy.com
MASTER_PASSWORD=

# CORS 허용 출처 (프론트 도메인). 비우면 전체 허용("*"). 단일 컨테이너 배포 시 불필요.
CORS_ORIGINS=*

# SMTP Settings (장애 알림 이메일 발송)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
# 발신자 표기 주소. 비우면 SMTP_USER로 발송(권장 — 미보유 도메인은 스팸함행 위험)
SMTP_FROM_EMAIL=

# 점검 로그 보존 기간(일) — 지나면 매일 자동 삭제
LOG_RETENTION_DAYS=180

# === AI 스팸 분류 (OpenAI / GPT) ===
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=
# 사용할 모델 (기본 gpt-4o-mini — 저렴하고 빠름)
OPENAI_MODEL=gpt-4o-mini

# (선택) 슬랙 알림 웹훅 — 신규 상담 리드 등 알림
SLACK_WEBHOOK_URL=
